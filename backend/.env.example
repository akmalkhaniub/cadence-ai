# ==============================================================================
# Cadence AI Environment Configuration (.env.example)
# ==============================================================================

# Core Runtime
ENVIRONMENT=development
PROJECT_NAME="Cadence AI"
API_V1_STR=/api/v1

# Database Configuration
# Local SQLite (Default for fast zero-dependency evaluation):
DATABASE_URL=sqlite+aiosqlite:///./cadence_dev.db
# PostgreSQL / pgvector (For production or docker evaluation):
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/cadence_prod

# Redis (Event Bus & Asynchronous Queues)
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# LLM Provider API Keys (Insert your preferred keys for testing)
# ==============================================================================
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model Selection: gpt-4o, claude-3-5-sonnet, or gemini-1.5-pro
LLM_MODEL=gpt-4o

# ==============================================================================
# Observability & Tracing (Langfuse)
# ==============================================================================
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=http://localhost:3000

# Security & Multi-Tenancy
JWT_SECRET=cadence_enterprise_jwt_secret_dev_2026
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
